{
  "name": "course-forge-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8000",
    "dev:android-offline": "cross-env VITE_APP_MODE=android-offline vite --host 0.0.0.0 --port 8000",
    "dev:android-teacher-offline": "node scripts/android-teacher/build-pack.mjs && cross-env VITE_APP_MODE=android-teacher-offline VITE_ANDROID_APP_MODE=teacher-presentation-offline VITE_OFFLINE_BOOK_SLUG=ultimate-b2 vite --host 0.0.0.0 --port 8000",
    "dev:netlify": "node scripts/run-netlify-dev.mjs",
    "test": "node --test",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "test:integration:cleanup": "node scripts/cleanup-integration-schemas.mjs",
    "test:e2e": "playwright test",
    "pilot:demo:seed": "node scripts/seed-local-pilot.mjs",
    "demo:multi-school:setup": "node scripts/local-multi-school-demo.mjs setup --confirm=isolated-local-multi-school-demo",
    "demo:multi-school:start": "node scripts/local-multi-school-demo.mjs start --confirm=isolated-local-multi-school-demo",
    "demo:multi-school:verify": "node scripts/local-multi-school-demo.mjs verify --confirm=isolated-local-multi-school-demo",
    "demo:multi-school:reset": "node scripts/local-multi-school-demo.mjs reset --confirm=isolated-local-multi-school-demo",
    "platform-admin:create": "node scripts/create-platform-admin.mjs",
    "audit:ultimate-b2:functional": "node scripts/ultimate-b2/generate-functional-audit.mjs",
    "audit:source-structure": "node scripts/audit-source-structure.mjs",
    "test:e2e:staging": "playwright test",
    "staging:migrate": "node scripts/run-staging-migrations.mjs",
    "staging:integrity": "node scripts/verify-tenant-integrity.mjs",
    "staging:seed": "node scripts/seed-staging-qa.mjs",
    "staging:seed:multi-school": "node scripts/seed-multi-school.mjs",
    "staging:smoke": "node scripts/run-staging-smoke-tests.mjs",
    "staging:cleanup": "node scripts/cleanup-staging-qa.mjs",
    "staging:cleanup:multi-school": "node scripts/cleanup-multi-school.mjs",
    "test:tenant-isolation": "node --test --test-concurrency=1 tests/integration/authorization-flows.test.js tests/integration/book-licensing.test.js",
    "staging:verify": "node scripts/run-staging-verification.mjs",
    "staging:verify:ultimate-b2": "node scripts/verify-ultimate-b2-staging-hardening.mjs",
    "staging:preflight": "node scripts/check-staging-deployment.mjs",
    "staging:email-test": "node scripts/verify-staging-email.mjs",
    "build": "vite build",
    "verify:web-bundle-safety": "node scripts/verify-web-bundle-safety.mjs",
    "build:android-offline": "cross-env VITE_APP_MODE=android-offline vite build",
    "verify:android-student-bundle-safety": "node scripts/verify-web-bundle-safety.mjs dist",
    "build:android-teacher-offline": "node scripts/android-teacher/build-pack.mjs && node scripts/android-teacher/verify-pack.mjs && cross-env VITE_APP_MODE=android-teacher-offline VITE_ANDROID_APP_MODE=teacher-presentation-offline VITE_OFFLINE_BOOK_SLUG=ultimate-b2 vite build && node scripts/android-teacher/verify-bundle.mjs",
    "verify:android-teacher-pack": "node scripts/android-teacher/verify-pack.mjs",
    "verify:android-teacher-media": "node scripts/android-teacher/verify-media.mjs",
    "verify:android-teacher-apk": "node scripts/android-teacher/verify-apk.mjs",
    "test:android-teacher-offline:smoke": "node scripts/android-teacher/manual-smoke.mjs",
    "test:android-teacher-offline:viewports": "node scripts/android-teacher/viewport-matrix.mjs",
    "test:ultimate-b2:legacy-pilot:assets": "node --test tests/ultimate-b2-unit-1-part-2-legacy-pilot.test.js",
    "test:ultimate-b2:legacy-pilot:visual": "node scripts/ultimate-b2/legacy-pilot-visual.mjs",
    "test:ultimate-b2:legacy-pilot:modes": "node scripts/ultimate-b2/legacy-pilot-modes.mjs",
    "test:android-teacher-device": "node scripts/android-teacher/device-smoke.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 8000",
    "android:init": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:gradle": "node scripts/android/run-gradle.mjs",
    "android:build": "npm run build:android-offline && npm run android:sync && npm run android:gradle -- assembleDebug",
    "android:teacher:sync": "npm run build:android-teacher-offline && cross-env CAPACITOR_BUILD_MODE=teacher npx cap sync android",
    "android:teacher:build": "node scripts/android-teacher/build-apk.mjs",
    "books:validate": "node scripts/books/cli.mjs validate",
    "books:inventory": "node scripts/books/cli.mjs inventory",
    "books:import:dry-run": "node scripts/books/cli.mjs import --dry-run",
    "books:import": "node scripts/books/cli.mjs import",
    "books:verify": "node scripts/books/cli.mjs verify",
    "books:cleanup-failed": "node scripts/books/cli.mjs cleanup-failed",
    "ultimate-b2:scan:students-book": "node scripts/ultimate-b2/scan-students-book.mjs",
    "ultimate-b2:extract:activities": "node scripts/ultimate-b2/extract-activities.mjs",
    "ultimate-b2:build:unit-01": "node scripts/ultimate-b2/build-unit-01-implementation.mjs",
    "ultimate-b2:build:unit-02": "node scripts/ultimate-b2/build-unit-02-implementation.mjs",
    "ultimate-b2:build:content": "node scripts/ultimate-b2/build-students-book-content.mjs",
    "ultimate-b2:audit:legacy-flash": "node scripts/ultimate-b2/legacy-flash-audit.mjs",
    "ultimate-b2:test:legacy-flash": "node scripts/ultimate-b2/run-legacy-flash-proof.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.848.0",
    "@aws-sdk/s3-request-presigner": "^3.848.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.0",
    "@capacitor/status-bar": "^8.0.2",
    "@neondatabase/serverless": "^1.1.0",
    "@ruffle-rs/ruffle": "0.4.0",
    "@vitejs/plugin-react": "latest",
    "bcryptjs": "^3.0.3",
    "fast-xml-parser": "5.10.1",
    "framer-motion": "latest",
    "lucide-react": "latest",
    "nodemailer": "^9.0.3",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "^0.35.3",
    "vite": "^8.1.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "pg": "^8.22.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
