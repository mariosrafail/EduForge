{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eduforge.invalid/schemas/book-manifest-1.0.json",
  "title": "EduForge Book Manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "publisher", "book", "edition", "components", "assets"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "publisher": { "$ref": "#/$defs/publisher" },
    "book": { "$ref": "#/$defs/book" },
    "edition": { "$ref": "#/$defs/edition" },
    "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } },
    "assets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/asset" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "publisher": { "type": "object", "additionalProperties": false, "required": ["id", "name", "slug"], "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 }, "slug": { "$ref": "#/$defs/id" } } },
    "book": { "type": "object", "additionalProperties": false, "required": ["id", "slug", "title", "version"], "properties": { "id": { "$ref": "#/$defs/id" }, "slug": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1 }, "level": { "type": "string" }, "description": { "type": "string" }, "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" } } },
    "edition": { "type": "object", "additionalProperties": false, "required": ["id", "identifier"], "properties": { "id": { "$ref": "#/$defs/id" }, "identifier": { "$ref": "#/$defs/id" }, "title": { "type": "string" } } },
    "component": { "type": "object", "additionalProperties": false, "required": ["id", "slug", "title", "type", "units"], "properties": { "id": { "$ref": "#/$defs/id" }, "slug": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "type": { "type": "string" }, "units": { "type": "array", "items": { "$ref": "#/$defs/unit" } } } },
    "unit": { "type": "object", "additionalProperties": false, "required": ["id", "slug", "title", "number", "lessons", "pages"], "properties": { "id": { "$ref": "#/$defs/id" }, "slug": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "number": { "type": "integer", "minimum": 1 }, "lessons": { "type": "array", "items": { "$ref": "#/$defs/lesson" } }, "pages": { "type": "array", "items": { "$ref": "#/$defs/page" } } } },
    "lesson": { "type": "object", "additionalProperties": false, "required": ["id", "slug", "title", "type", "activities"], "properties": { "id": { "$ref": "#/$defs/id" }, "slug": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "type": { "type": "string" }, "activities": { "type": "array", "items": { "$ref": "#/$defs/activity" } } } },
    "activity": { "type": "object", "additionalProperties": false, "required": ["id", "slug", "title", "type", "assignable", "accessLevel", "status"], "properties": { "id": { "$ref": "#/$defs/id" }, "slug": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "type": { "type": "string" }, "instructions": { "type": "string" }, "assignable": { "type": "boolean" }, "accessLevel": { "enum": ["public", "preview", "entitled", "internal"] }, "answers": { "type": "object" }, "feedback": { "type": "object" }, "assetIds": { "type": "array", "items": { "type": "string" } }, "sourceReference": { "type": "string" }, "status": { "enum": ["fully-interactive", "media-only", "imported-interaction-pending", "offline-only"] } } },
    "page": { "type": "object", "additionalProperties": false, "required": ["id", "stableKey", "number", "assetIds"], "properties": { "id": { "$ref": "#/$defs/id" }, "stableKey": { "type": "string" }, "number": { "type": "integer", "minimum": 1 }, "label": { "type": "string" }, "sourceReference": { "type": "string" }, "assetIds": { "type": "array", "items": { "type": "string" } }, "hotspots": { "type": "array", "items": { "$ref": "#/$defs/hotspot" } } } },
    "hotspot": { "type": "object", "additionalProperties": false, "required": ["id", "label", "left", "top", "width", "height"], "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "type": "string" }, "left": { "type": "number", "minimum": 0, "maximum": 100 }, "top": { "type": "number", "minimum": 0, "maximum": 100 }, "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }, "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }, "activityId": { "type": "string" } } },
    "asset": { "type": "object", "additionalProperties": false, "required": ["id", "logicalKey", "role", "source", "mimeType", "accessLevel", "publicationStatus", "classification", "componentId"], "properties": { "id": { "$ref": "#/$defs/id" }, "logicalKey": { "type": "string" }, "role": { "type": "string" }, "source": { "type": "string" }, "mimeType": { "enum": ["image/jpeg", "image/png", "image/webp", "image/svg+xml", "audio/mpeg", "audio/mp4", "video/mp4", "application/pdf", "application/zip", "application/json"] }, "accessLevel": { "enum": ["public", "preview", "entitled", "internal"] }, "publicationStatus": { "enum": ["draft", "processing", "published", "archived", "failed"] }, "classification": { "enum": ["fully-interactive", "media-only", "page-image", "preview", "imported-interaction-pending", "offline-only", "unused-duplicate"] }, "componentId": { "type": "string" }, "unitId": { "type": "string" }, "pageId": { "type": "string" }, "activityId": { "type": "string" }, "sourceReference": { "type": "string" }, "imageStrategy": { "enum": ["preserve", "page", "thumbnail"] } } }
  }
}
