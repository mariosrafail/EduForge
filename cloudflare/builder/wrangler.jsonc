{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "builder",
  "main": "./worker.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "r2_buckets": [
    {
      "binding": "PLAYER_MEDIA",
      "bucket_name": "hhplms-book-public-dev"
    }
  ],
  "assets": {
    "directory": "../../dist-cloudflare/builder",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/builder/api/*",
      "/builder/preview/*",
      "/preview/*",
      "/player-media/*",
      "/player",
      "/player/*",
      "!/player/assets/*"
    ]
  }
}
