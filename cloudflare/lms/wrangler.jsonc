{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lms",
  "main": "./worker.js",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "../../dist-cloudflare/lms",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/.netlify/functions/*", "/platform-admin/*"]
  }
}
