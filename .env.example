# Runtime/database
DATABASE_URL=postgresql://USER:PASSWORD@STAGING_HOST/eduforge_staging?sslmode=require
APP_PUBLIC_URL=https://staging.example.invalid

# Account security and private operations
ACCOUNT_RATE_LIMIT_SALT=replace-with-a-long-random-staging-secret
INVITE_RATE_LIMIT_SALT=replace-with-a-different-long-random-staging-secret
ACCOUNT_EMAIL_DISPATCH_SECRET=replace-with-a-long-random-staging-secret
OPERATIONAL_MONITORING_SECRET=replace-with-a-long-random-staging-secret
ACCOUNT_INVITATIONS_ENABLED=true

# SMTP (server-side only)
ACCOUNT_EMAIL_MODE=smtp
SMTP_HOST=smtp.staging-provider.invalid
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=staging-smtp-user
SMTP_PASS=replace-with-staging-smtp-password
SMTP_FROM=EduForge Staging <noreply@staging.example.invalid>

# Hosted staging verification
STAGING_DATABASE_URL=postgresql://USER:PASSWORD@STAGING_HOST/eduforge_staging?sslmode=require
STAGING_DATABASE_CONFIRMATION=isolated-staging-database
STAGING_ENVIRONMENT_CONFIRMATION=hosted-nonproduction-staging
PRODUCTION_DATABASE_FINGERPRINT=sha256-of-production-host-port-and-database
STAGING_PRODUCTION_APP_URL=https://app.example.invalid
STAGING_EMAIL_RECIPIENT=qa+staging@example.invalid
STAGING_EMAIL_CONFIRMATION=dedicated-nonproduction-inbox
EDUFORGE_STAGING_QA_PASSWORD=replace-with-a-unique-generated-qa-password

# Lifecycle retention (days)
ACCOUNT_RATE_LIMIT_RETENTION_DAYS=7
ACCOUNT_TOKEN_RETENTION_DAYS=30
ACCOUNT_OUTBOX_RETENTION_DAYS=90
INVITE_ATTEMPT_RETENTION_DAYS=7
STALE_OUTBOX_CLAIM_MINUTES=15

# Build/monitoring metadata
BUILD_ID=local-build-identifier

# Isolated tests
TEST_DATABASE_URL=postgresql://TEST_USER:TEST_PASSWORD@localhost/eduforge_test
TEST_DATABASE_CONFIRMATION=isolated-test-database
E2E_STAGING_URL=https://staging.example.invalid
E2E_STAGING_CONFIRMATION=hosted-nonproduction-staging
E2E_ADMIN_EMAIL=qa-admin@staging.example.invalid
E2E_ADMIN_PASSWORD=replace-at-runtime
