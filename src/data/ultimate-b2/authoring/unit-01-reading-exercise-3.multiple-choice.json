    {
      "id": "ultimate-b2-sb-u1-p2-o3-q4", "number": 4, "panelId": "panel-1", "prompt": "Why does the writer express concern about binge-watching?", "correctOptionId": "ultimate-b2-sb-u1-p2-o3-q4-o1", "referenceArea": { "x": 482, "y": 305, "width": 44, "height": 44 }, "audioLogicalKey": "ultimate-b2.legacy-pilot.unit-1.part-2.obj3.highlight-4", "persistSolved": true,
      "options": [
        { "id": "ultimate-b2-sb-u1-p2-o3-q4-o1", "label": "A", "text": "It might prevent people from socialising with friends.", "area": { "x": 553, "y": 356, "width": 30, "height": 30 } },
