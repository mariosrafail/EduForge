    {
      "id": "ultimate-b2-sb-u1-p2-o3-q5", "number": 5, "panelId": "panel-2", "prompt": "What significant difference between films and series does the author mention?", "correctOptionId": "ultimate-b2-sb-u1-p2-o3-q5-o3", "referenceArea": { "x": 8, "y": 35, "width": 44, "height": 44 }, "audioLogicalKey": "ultimate-b2.legacy-pilot.unit-1.part-2.obj3.highlight-5", "persistSolved": true,
