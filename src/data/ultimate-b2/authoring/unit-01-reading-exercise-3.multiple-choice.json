      "id": "ultimate-b2-sb-u1-p2-o3-q3", "number": 3, "panelId": "panel-1", "prompt": "According to the text, when viewers binge-watch, they", "correctOptionId": "ultimate-b2-sb-u1-p2-o3-q3-o1", "referenceArea": { "x": 482, "y": 97, "width": 44, "height": 44 }, "audioLogicalKey": "ultimate-b2.legacy-pilot.unit-1.part-2.obj3.highlight-3", "persistSolved": true,
